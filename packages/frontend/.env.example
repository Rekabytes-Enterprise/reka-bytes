# URL the Next.js rewrite proxies /api/* to (server-side only)
BACKEND_URL="http://localhost:4300"

# Used by shared apiFetch for absolute URLs (browser-side); the rewrite makes
# relative /api calls work without this in local dev.
NEXT_PUBLIC_BACKEND_URL=""

# ---------------------------------------------------------------------------
# Operator identity for the public legal documents (/privacy, /terms,
# /cookies) and the landing footer.
#
# These are deliberately NOT `NEXT_PUBLIC_*` — Next inlines a prefixed var into
# the client bundle, and none of these belong there. Every consumer is a server
# component (lib/legal.ts), so the values stay on the server.
#
# Anything unset renders as a visible "not configured" chip on those pages
# rather than a blank, so a half-configured install cannot quietly ship someone
# else's policy — or look finished when it isn't.
#
# The document TEXT (statutes, liability cap, governing law) lives in the
# page.tsx files — rewrite it for your own jurisdiction if needed.
# ---------------------------------------------------------------------------

# Legal name of the data controller / contracting party. Defaults to "Reka Bytes"
# in lib/legal.ts when unset, so leaving this blank is fine when the brand name
# IS the legal name.
LEG_OPERATOR_NAME=
# Founder's full name, rendered on /about. Unset falls back to a visible
# placeholder rather than an empty heading.
LEG_FOUNDER_NAME=
# Business / company registration number (SSM no.). Quoted in the PDPA-style
# notice. Blank → "not configured" chip.
LEG_OPERATOR_REGISTRATION=
# Optional one-line description of the legal form, e.g.
# "a business registered in Malaysia under the Registration of Businesses Act
# 1956, which is not a separate legal person". The row is omitted when blank.
LEG_OPERATOR_ENTITY_NOTE=
# Country the operator is based in. Drives the footer's "made in …" line.
# Blank → defaults to "Malaysia" (the project is Malaysia-shaped).
LEG_OPERATOR_COUNTRY=

# ONE inbox for data requests, support, abuse and security reports. Without it
# the contact blocks and the footer show a chip instead of an address.
LEG_CONTACT_EMAIL=
# Correspondence address. Leave blank to publish a "not published — supplied on
# request to a data subject, the Commissioner or a court" statement instead.
LEG_POSTAL_ADDRESS=

# Where the hosted database physically runs (e.g. "Malaysia (Kuala Lumpur)" or
# "ap-southeast-1"). Feeds the cross-border-transfer section; unset shows a chip.
LEG_HOSTING_REGION=
# How long database backups and platform logs are kept, e.g. "30 days rolling".
# Caps how fast deletion is final; unset shows a chip.
LEG_BACKUP_RETENTION=

# Public profiles. Unlike the fields above, an unset value renders NOTHING
# rather than a chip — a missing social link is not a compliance gap.
# Full URL including https://, no trailing slash.
LEG_SOCIAL_GITHUB=
