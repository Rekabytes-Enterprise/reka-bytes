# Server
PORT=4300

# Public origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:4301,http://localhost:4302

# PostgreSQL — must match packages/db/.env (host port 5433 → container 5432)
DATABASE_URL="postgresql://reka:reka_dev_password@localhost:5433/rekabytes?schema=public"

# Redis (host port 6380 → container 6379)
REDIS_URL="redis://localhost:6380"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET="dev-only-secret-replace-in-production-0123456789"

# Rate limiting (requests per minute per IP on auth endpoints)
RATE_LIMIT_PER_MINUTE=60

# Admin seed credentials (used by pnpm db:seed)
ADMIN_EMAIL=admin@rekabytes.dev
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Reka Admin

# AI Masterclass — OpenRouter (OpenAI-compatible). Never hardcode keys/models in source.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=stealth/ox-alpha

# Timeout for BAML LLM calls in ms — set via the client's nested `http` block
# (flat timeout keys are IGNORED by BAML). Without it BAML defaults to a 300s
# total request timeout, which kills slow reasoning-model passes.
# Default: 900000 (15 min); set 0 for NO timeout (infinite).
AI_TIMEOUT_MS=900000

# Daily generation limits (per admin)
AI_DAILY_GEN_LIMIT=20
AI_DAILY_REGEN_LIMIT=50

# '1' → skip extraction + LLM entirely; deterministic fixture output (used by e2e)
AI_MOCK=0
