generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING)
  application  Application?
  decisionsMade Application[] @relation("DecidedBy")
  auditLogs    AuditLog[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  blockEvents    BlockEvent[]
  xpEvents       XpEvent[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

model Cohort {
  id           String        @id @default(cuid())
  name         String        @unique
  cap          Int
  isCurrent    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Application {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId      String?
  cohort        Cohort?    @relation(fields: [cohortId], references: [id])
  schemaVersion Int
  answers       Json
  internalNote  String?
  decidedAt     DateTime?
  decidedById   String?
  decidedBy     User?      @relation("DecidedBy", fields: [decidedById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdAt])
  @@index([cohortId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model Class {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
}

model Module {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons   Lesson[]
  quiz      Quiz?
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  contentMarkdown String
  /** Typed block body (LESSON-PLAN §4). Nullable — legacy markdown stays authoritative when null. */
  blocks          Json?
  videoUrl        String?
  durationMinutes Int              @default(10)
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  progress        LessonProgress[]
  blockEvents     BlockEvent[]
}

model Quiz {
  id           String         @id @default(cuid())
  moduleId     String         @unique
  module       Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int            @default(80)
  required     Boolean        @default(false)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  questions    QuizQuestion[]
  attempts     QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question     String
  options      Json
  correctIndex Int
  order        Int    @default(0)
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([lessonId, userId])
}

/// Append-only telemetry for interactive lesson blocks (inline-check attempts).
/// Kept separate from LessonProgress so answering a check never implies completion.
model BlockEvent {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([lessonId, userId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  answers   Json?
  createdAt DateTime @default(now())
}

/// Append-only XP ledger (PRD-04 §3.1). Balance = sum(amount). Never decremented.
/// @@unique makes awards idempotent: one event per (user, reason, ref) — re-awards are P2002 no-ops.
/// reason: LESSON_COMPLETED | MODULE_COMPLETED | CLASS_COMPLETED | QUIZ_PASSED | PERFECT_QUIZ
/// refId: lessonId / moduleId / classId / quizId respectively.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

// ── Marketing site (company /) ─────────────────────────────────────────────

enum LeadService {
  CONSULTATION
  MOCKUP
  PRD
  BUILD
}

enum LeadPlatform {
  MOBILE
  WEB
  BOTH
  UNSURE
}

enum LeadBudget {
  UNDER_5K
  RANGE_5_15K
  RANGE_15_50K
  OVER_50K
  UNSURE
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
  ARCHIVED
}

/// Inbound enquiry from the public company site "start small" funnel — free
/// consultation / free mockup / RM 150 PRD. No user relation: submitters are
/// NOT registered users. Honeypot submissions never reach this table.
model Lead {
  id         String       @id @default(cuid())
  name       String
  email      String
  phone      String?
  service    LeadService  @default(CONSULTATION)
  platform   LeadPlatform @default(UNSURE)
  budget     LeadBudget   @default(UNSURE)
  message    String       @db.Text
  status     LeadStatus   @default(NEW)
  adminNotes String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}
